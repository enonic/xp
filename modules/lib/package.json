{
    "name": "lib",
    "private": true,
    "version": "1.0.0",
    "description": "Root package for libs development.",
    "scripts": {
        "build": "tsc --declaration --project tsconfig.build.json",
        "lint": "oxlint",
        "fix": "oxlint --fix",
        "jsdoc": "jsdoc --configure jsdoc/conf.json",
        "test:types": "tsd -t build/npm/global.d.ts -f test/**/*.test-d.ts",
        "test:packages": "node scripts/test-packages.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/enonic/xp.git#master"
    },
    "contributors": [
        "Mikita Taukachou <edloidas@gmail.com> (https://edloidas.github.io/)"
    ],
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/enonic/xp/issues"
    },
    "homepage": "https://github.com/enonic/xp/tree/master#readme",
    "packageManager": "pnpm@12.11.2",
    "tsd": {
        "compilerOptions": {
            "target": "es5"
        }
    },
    "devDependencies": {
        "jsdoc": "^4.0.5",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "tsd": "^0.33.0",
        "typescript": "^5.9.3"
    }
}
