{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "@id@",
  "$defs": {
    "localizedTextDef": {},
    "genericValueDef": {}
  },
  "description": "YAML descriptor for Enonic XP Applications.\nhttps://developer.enonic.com/docs/code/stable/fundamentals/apps",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "Application"
    },
    "type": {
      "type": "string",
      "enum": [
        "Static",
        "Bundle"
      ],
      "default": "Bundle",
      "description": "Application type. Defaults to Bundle."
    },
    "title": {
      "$ref": "#/$defs/localizedTextDef"
    },
    "description": {
      "$ref": "#/$defs/localizedTextDef"
    },
    "vendorName": {
      "type": "string"
    },
    "vendorUrl": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/genericValueDef"
    }
  },
  "required": [
    "kind"
  ],
  "additionalProperties": false
}
